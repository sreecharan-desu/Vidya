# ---------------------------------------------------------------------------
# Local Postgres — same URL for Docker (`pnpm docker:up`) or Homebrew
# (`npm run pg-admin`: installs/starts Postgres, creates vidya/vidya, opens pgAdmin)
# pgAdmin: Host localhost | Port 5432 | User vidya | Password vidya | DB vidya
# Copy this file to `.env` for local. Never put Neon secrets here.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://vidya:vidya@localhost:5432/vidya?schema=public"
DIRECT_URL="postgresql://vidya:vidya@localhost:5432/vidya?schema=public"

# ---------------------------------------------------------------------------
# Production Neon — from `neon deploy` / `neon env pull` → `.env.local`
# (gitignored). On Vercel, set the same keys in project env.
# DATABASE_URL            → pooled (-pooler) for the Nest/Prisma app
# DATABASE_URL_UNPOOLED   → direct for prisma migrate (also set as DIRECT_URL)
# NEON_BRANCH             → branch name (e.g. production)
# ---------------------------------------------------------------------------

# API
PORT=4000
JWT_SECRET="change-me-in-production"

# SMTP — Mailhog locally; real SMTP via secrets in prod
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Vidya <noreply@vidya.local>"

# Clients
NEXT_PUBLIC_API_URL="http://localhost:4000"
EXPO_PUBLIC_API_URL="http://localhost:4000"
