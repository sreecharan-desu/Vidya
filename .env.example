# ---------------------------------------------------------------------------
# Local Docker (default) — `pnpm docker:up` starts postgres + mailhog
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://vidya:vidya@localhost:5432/vidya?schema=public"
DIRECT_URL="postgresql://vidya:vidya@localhost:5432/vidya?schema=public"

# ---------------------------------------------------------------------------
# Production / shared Neon (set in GitHub Actions secrets — never commit)
# DATABASE_URL  → pooled Neon connection (app runtime)
# DIRECT_URL    → non-pooled Neon connection (prisma migrate)
# ---------------------------------------------------------------------------

# API
PORT=4000
JWT_SECRET="change-me-in-production"

# SMTP — Mailhog locally; real SMTP via GitHub secrets in prod (coming soon)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Vidya <noreply@vidya.local>"

# Clients
NEXT_PUBLIC_API_URL="http://localhost:4000"
EXPO_PUBLIC_API_URL="http://localhost:4000"
