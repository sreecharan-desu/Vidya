generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  name              String
  role              UserRole
  passwordHash      String
  emailVerifiedAt   DateTime?
  emailOtpHash      String?
  emailOtpExpiresAt DateTime?
  emailOtpPurpose   EmailOtpPurpose?
  createdAt         DateTime         @default(now())
}

enum UserRole {
  STUDENT
  ADMIN
}

enum EmailOtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}
