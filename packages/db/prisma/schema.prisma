generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Non-pooled Neon URL for migrations (optional locally — set same as DATABASE_URL for Docker)
  directUrl = env("DIRECT_URL")
}

/// App users. Students are provisioned (no public registration).
/// OTP columns are used by admin auth (verify / forgot-password) under /api/admin/auth.
model User {
  id                String           @id @default(cuid())
  email             String           @unique
  name              String
  role              UserRole
  passwordHash      String
  department        String?
  emailVerifiedAt   DateTime?
  emailOtpHash      String?
  emailOtpExpiresAt DateTime?
  emailOtpPurpose   EmailOtpPurpose?
  createdAt         DateTime         @default(now())
}

enum UserRole {
  STUDENT
  ADMIN
}

enum EmailOtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}
