    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "bcrypt": "^6.0.0",
    "fastify": "^5.12.7",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/bcrypt": "^6.0.0",
