{
  "name": "@vidya/root",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:app": "node scripts/start.mjs --app",
    "db:psql": "node scripts/db-psql.mjs",
    "db:migrate": "pnpm --dir packages/db migrate",
    "db:seed": "pnpm --dir packages/db seed",
    "backend:ngrok": "node scripts/backend-ngrok.mjs",
    "postman:export": "python3 scripts/export-postman-collection.py",
    "dev:student-mobile": "cd apps/student-mobile && npx expo start --lan",
    "dev:api": "cd apps/api && pnpm dev",
    "docker:up": "bash scripts/dev-up.sh",
    "docker:down": "bash scripts/dev-down.sh",
    "docker:logs": "bash scripts/dev-logs.sh",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "build": "turbo build"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "^19.2.2",
    "turbo": "^2.1.3",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@8.15.8",
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.12.7",
      "nodemailer": "10.2.1",
      "uuid": "11.1.1",
      "postcss-selector-parser": "7.1.7",
      "js-yaml@^5.0.0": "5.5.0",
      "js-yaml@~5": "5.5.0"
    }
  }
}
