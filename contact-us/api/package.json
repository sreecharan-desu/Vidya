{
  "name": "@vidya-contact/api",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone NestJS + Fastify + raw pg API for the Vidya Complaints & Help module.",
  "main": "src/main.ts",
  "scripts": {
    "dev": "tsx watch --import reflect-metadata src/main.ts",
    "start": "tsx --import reflect-metadata src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
